// 소스코드 작성
  #include <stdio.h>

int main() 
{
    char ch;
    char temp;
    while (1) 
    {
        putchar('-'); putchar('-'); 
        char msg1[] = "문자입력 : ";
        for (int i = 0; msg1[i] != '\0'; i++) 
        {
            putchar(msg1[i]);
        }
        ch = getchar();
        if (ch == 'q' || ch == 'Q') 
        {
            break;
        }
        char msg2[] = "입력된 문자는 ";
        for (int i = 0; msg2[i] != '\0'; i++)
          {
            putchar(msg2[i]);
        }
        putchar(ch);
        putchar('\n');
        while ((temp = getchar()) != '\n' && temp != EOF);
    }
    return 0;
}



// **********************************************
// 소스코드 작성
#include <stdio.h>
#include <string.h>

int main(void) 
{
    char str[100];
    int count = 0;
    int i = 0;

    printf("문자열입력: ");
    fgets(str, sizeof(str), stdin);
    str[strcspn(str, "\n")] = '\0';
    if (str[0] == '\0') {
        printf("단어수 : 0\n");
        return 0;
    }
    if (str[0] != ' ') 
    {
        count = 1;
    }
    while (str[i] != '\0') {
        if (str[i] == ' ' && str[i + 1] != ' ' && str[i + 1] != '\0') {
            count++;
        }
        i++;
    }
    printf("단어수 : %d\n", count);
    return 0;
}

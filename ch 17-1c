#include <stdio.h>

int get_max(int* arr[], int size);

int main(void)
{
    int num1 = 50, num2 = 20, num3 = 30;
    int* ptrarr[3] = {&num1, &num2, &num3};
    int max;
    
    max = get_max(ptrarr, 3); 
    printf("최댓값:%d\n", max);
    
    return 0;
}

int get_max(int* arr[], int size)
{

    int max_val = *(arr[0]); 
    
    for (int i = 1; i < size; i++)
    {
        if (*(arr[i]) > max_val)
        {
            max_val = *(arr[i]);
        }
    }
    
    return max_val;
}

